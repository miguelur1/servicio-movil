{
  "name": "servicio-movil",
  "productName": "MVR Servicio Móvil",
  "version": "0.3.0",
  "description": "Herramienta de servicio técnico para Android e iPhone en Windows (ADB, Fastboot, libimobiledevice).",
  "main": "src/main/main.js",
  "author": "Miguel Velasco Rebollo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-tools": "node scripts/fetch-tools.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miguelur1.serviciomovil",
    "productName": "MVR Servicio Móvil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "MVR-ServicioMovil-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MVR Servicio Móvil"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "miguelur1",
        "repo": "servicio-movil",
        "releaseType": "release"
      }
    ],
    "copyright": "Desarrollado por Miguel Velasco Rebollo"
  }
}
